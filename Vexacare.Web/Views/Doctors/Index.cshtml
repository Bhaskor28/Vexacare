                                                        <div class="tm-card-tag-wrapper">
                                                            @{
                                                                if (!string.IsNullOrEmpty(Model.ProfileBasic?.AreaofExperties))
                                                                {
                                                                    // Combined regex to match both <li> and <p> tags
                                                                    var matches = Regex.Matches(Model.ProfileBasic?.AreaofExperties, @"<(?:li|p)>(.*?)</(?:li|p)>");

                                                                    if (matches.Count > 0)
                                                                    {
                                                                        for (int i = 0; i < Math.Min(2, matches.Count); i++)
                                                                        {
                                                                            <span class="expertise-badge">@Html.Raw(matches[i].Groups[1].Value.Trim())</span>
                                                                            // <p class="tm-card-tag">@Html.Raw(matches[i].Groups[1].Value.Trim())</p>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        // Fallback for content without expected tags
                                                                        var lines = Model.ProfileBasic?.AreaofExperties.Split(new[] { '\n', ',', ';' }, StringSplitOptions.RemoveEmptyEntries);

                                                                        for (int i = 0; i < Math.Min(2, lines.Length); i++)
                                                                        {
                                                                            <span class="expertise-badge">@lines[i].Trim()</span>
                                                                            // <p class="tm-card-tag">@lines[i].Trim()</p>
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        </div>
