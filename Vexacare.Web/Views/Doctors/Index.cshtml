<script>
        // Password validation functionality
    document.addEventListener('DOMContentLoaded', function() {
        const newPasswordInput = document.querySelector('input[name="ChangePassword.NewPassword"]');
        const confirmPasswordInput = document.querySelector('input[name="ChangePassword.ConfirmPassword"]');
        const submitButton = document.getElementById('submit-password-btn');
        const progressBar = document.querySelector('.password-strength .progress-bar');
        const strengthText = document.querySelector('.password-strength-text');
        const matchText = document.querySelector('.password-match-text');

        if (newPasswordInput && confirmPasswordInput) {
            // Real-time password strength checking
            newPasswordInput.addEventListener('input', function() {
                validatePasswordStrength(this.value);
                validatePasswordMatch();
                updateSubmitButton();
            });

            // Real-time password matching
            confirmPasswordInput.addEventListener('input', function() {
                validatePasswordMatch();
                updateSubmitButton();
            });

            // Validate on form submission
            const form = document.getElementById('change-password-form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (!isFormValid()) {
                        e.preventDefault();
                        highlightInvalidFields();
                    }
                });
            }
        }

        function validatePasswordStrength(password) {
            let strength = 0;
            const requirements = {
                hasUpper: /[A-Z]/.test(password),
                hasLower: /[a-z]/.test(password),
                hasNumber: /\d/.test(password),
                hasSpecial: /[^A-Za-z0-9]/.test(password),
                hasLength: password.length >= 6
            };

            // Update requirement indicators
            updateRequirement('req-uppercase', requirements.hasUpper);
            updateRequirement('req-lowercase', requirements.hasLower);
            updateRequirement('req-number', requirements.hasNumber);
            updateRequirement('req-special', requirements.hasSpecial);
            updateRequirement('req-length', requirements.hasLength);

            // Calculate strength score
            if (requirements.hasUpper) strength += 20;
            if (requirements.hasLower) strength += 20;
            if (requirements.hasNumber) strength += 20;
            if (requirements.hasSpecial) strength += 20;
            if (requirements.hasLength) strength += 20;

            // Update progress bar
            progressBar.style.width = strength + '%';

            // Set progress bar color and text based on strength
            if (strength < 40) {
                progressBar.className = 'progress-bar progress-bar-weak';
                strengthText.textContent = 'Weak password';
                strengthText.className = 'password-strength-text text-danger';
            } else if (strength < 80) {
                progressBar.className = 'progress-bar progress-bar-medium';
                strengthText.textContent = 'Medium strength';
                strengthText.className = 'password-strength-text text-warning';
            } else if (strength < 100) {
                progressBar.className = 'progress-bar progress-bar-strong';
                strengthText.textContent = 'Strong password';
                strengthText.className = 'password-strength-text text-success';
            } else {
                progressBar.className = 'progress-bar progress-bar-very-strong';
                strengthText.textContent = 'Very strong password';
                strengthText.className = 'password-strength-text text-primary';
            }
        }

        function updateRequirement(className, isValid) {
            const element = document.querySelector(`.${className}`);
            if (element) {
                const icon = element.querySelector('i');
                if (icon) {
                    icon.className = isValid ? 'fas fa-check text-success' : 'fas fa-times text-danger';
                }
            }
        }

        function validatePasswordMatch() {
            const newPassword = newPasswordInput.value;
            const confirmPassword = confirmPasswordInput.value;

            if (confirmPassword.length === 0) {
                matchText.textContent = '';
                matchText.className = 'password-match-text text-muted';
                confirmPasswordInput.classList.remove('is-valid', 'is-invalid');
            } else if (newPassword === confirmPassword) {
                matchText.textContent = 'Passwords match';
                matchText.className = 'password-match-text text-success';
                confirmPasswordInput.classList.add('is-valid');
                confirmPasswordInput.classList.remove('is-invalid');
            } else {
                matchText.textContent = 'Passwords do not match';
                matchText.className = 'password-match-text text-danger';
                confirmPasswordInput.classList.add('is-invalid');
                confirmPasswordInput.classList.remove('is-valid');
            }
        }

        function updateSubmitButton() {
            const isStrongPassword = calculatePasswordScore(newPasswordInput.value) >= 80;
            const passwordsMatch = newPasswordInput.value === confirmPasswordInput.value;
            const hasOldPassword = document.querySelector('input[name="ChangePassword.OldPassword"]').value.length > 0;

            submitButton.disabled = !(isStrongPassword && passwordsMatch && hasOldPassword);
        }

        function calculatePasswordScore(password) {
            let score = 0;
            if (/[A-Z]/.test(password)) score += 20;
            if (/[a-z]/.test(password)) score += 20;
            if (/\d/.test(password)) score += 20;
            if (/[^A-Za-z0-9]/.test(password)) score += 20;
            if (password.length >= 6) score += 20;
            return score;
        }

        function isFormValid() {
            const oldPassword = document.querySelector('input[name="ChangePassword.OldPassword"]').value;
            const newPassword = newPasswordInput.value;
            const confirmPassword = confirmPasswordInput.value;

            return oldPassword.length > 0 &&
                   calculatePasswordScore(newPassword) >= 80 &&
                   newPassword === confirmPassword;
        }

        function highlightInvalidFields() {
            const fields = [
                document.querySelector('input[name="ChangePassword.OldPassword"]'),
                newPasswordInput,
                confirmPasswordInput
            ];

            fields.forEach(field => {
                if (field.value.length === 0) {
                    field.classList.add('is-invalid');
                }
            });
        }
    });
</script>